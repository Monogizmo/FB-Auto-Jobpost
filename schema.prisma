// FB Auto Poster - Prisma schema (team edition with auth + encryption)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("recruiter") // admin | recruiter
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]
  pages        FacebookPage[] @relation("PageCreatedBy")
  logs         ActivityLog[]
  pagesManaged FacebookPage[] @relation("PageManagedBy")
}

model FacebookPage {
  id              String   @id @default(cuid())
  pageId          String   @unique // Facebook numeric page ID
  name            String
  encryptedToken  String   // AES-256-GCM encrypted Page Access Token
  avatar          String?
  category        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdById     String
  createdBy       User     @relation("PageCreatedBy", fields: [createdById], references: [id])
  managedById     String?
  managedBy       User?    @relation("PageManagedBy", fields: [managedById], references: [id])

  posts Post[]
}

model Post {
  id           String    @id @default(cuid())
  message      String
  linkUrl      String?
  imageUrl     String?
  status       String    @default("draft") // draft | scheduled | posting | posted | failed
  scheduledAt  DateTime?
  postedAt     DateTime?
  fbPostId     String?
  errorMessage String?
  pageId       String
  page         FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs ActivityLog[]

  @@index([status, scheduledAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // create | update | delete | publish | schedule | worker_tick | login | logout | user_create
  status     String   // success | error | info
  message    String
  createdAt  DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
